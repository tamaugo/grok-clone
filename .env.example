# Copy to .env (optional: every value has a default). Never commit .env.
# Bots run on the Claude Code CLI, so there are no API keys here: log in once on the
# machine with `claude` using your Claude subscription.

PORT=8787
HOST=127.0.0.1                # keep on localhost; expose it with Tailscale Serve
GROKBOT_USER_NAME=You         # how you are shown in chat

# Claude Code
# CLAUDE_BIN=~/.local/bin/claude
# CLAUDE_MODEL=               # model for Bots set to "Default": an alias such as sonnet or opus; empty = your account's default
# BOTS_ROOT=~/bots            # each Bot works in its own folder here
# DB_PATH=./data/grokbot.db

# RAM safeguards (each running Bot is a Claude process of roughly 300-500 MB)
# GROKBOT_MAX_CONCURRENT=2    # Bots working at once; the rest wait in line
# GROKBOT_MIN_FREE_MB=600     # don't start another Bot below this much free memory
# CHROMIUM_PATH=/usr/bin/chromium  # browser for Bot computers; empty = look in the usual places
# GROKBOT_MAX_SCREENS=2       # Bot computers (headless Chromium) running at once
# GROKBOT_SCREEN_IDLE_MIN=15  # put an unwatched computer to sleep after this long
# GROKBOT_TURN_TIMEOUT_MIN=45 # stop a single turn that runs longer than this
# GROKBOT_PROMPT_MEMORY_CHARS=4000

# Dev only: don't fire routines from a second server sharing a database copy
# GROKBOT_NO_SCHEDULER=1
